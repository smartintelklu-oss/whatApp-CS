  "rewrites": [
    {
      "source": "/api/webhook/fonnte",
      "destination": "/api/webhook/fonnte"
    },
    {
      "source": "/api/whatsapp/webhook-relay/sync",
      "destination": "/api/whatsapp/webhook-relay/sync"
    },
    {
      "source": "/api/whatsapp/webhook-relay/reset",
      "destination": "/api/whatsapp/webhook-relay/reset"
    },
    {
      "source": "/api/whatsapp/webhook-stats",
      "destination": "/api/whatsapp/webhook-stats"
    },
    {
      "source": "/api/whatsapp/connect-fonnte",
      "destination": "/api/whatsapp/connect-fonnte"
    },
    {
      "source": "/api/whatsapp/status",
      "destination": "/api/whatsapp/status"
    },
    {
      "source": "/api/whatsapp/send-message",
      "destination": "/api/whatsapp/send-message"
    },
    {
