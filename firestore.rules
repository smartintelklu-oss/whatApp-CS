rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Contact entity validation
    function isValidContact(data) {
      return data.keys().hasAll(['id', 'name', 'phone']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.phone is string && data.phone.size() <= 50;
    }

    // Contacts collection
    match /contacts/{contactId} {
      allow read: if true;
      allow create: if isValidId(contactId) && isValidContact(incoming()) && incoming().id == contactId;
      allow update: if isValidId(contactId) && isValidContact(incoming());
      allow delete: if isValidId(contactId);

      // Message validation
      function isValidMessage(data) {
        return data.keys().hasAll(['id', 'contactId', 'text', 'sender', 'timestamp']) &&
               data.id is string && data.id.size() <= 128 &&
               data.contactId is string && data.contactId == contactId &&
               data.text is string && data.text.size() <= 10000 &&
               data.sender is string && data.sender.size() <= 50;
      }

      // Messages sub-collection
      match /messages/{messageId} {
        allow read: if isValidId(contactId);
        allow create: if isValidId(contactId) && isValidId(messageId) && isValidMessage(incoming());
        allow update: if isValidId(contactId) && isValidId(messageId) && isValidMessage(incoming());
        allow delete: if isValidId(contactId) && isValidId(messageId);
      }
    }

    // Gateway config collection
    match /gateway_config/{configId} {
      allow read: if true;
      allow write: if isValidId(configId);
    }
  }
}
